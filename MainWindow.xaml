<Window x:Class="prakt7_trifonov_trpo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:prakt7_trifonov_trpo.Converters"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prakt7_trifonov_trpo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <conv:Rubletokopeyki x:Key="PriceConverter"/>
        <conv:LowStockConverter x:Key="StockColorConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="Склад" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <TextBlock Text="Название товара:"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="4"/>

            <TextBlock Text="Цена за единицу (в копейках):"/>
            <TextBox Text="{Binding UnitPrice, Converter={StaticResource PriceConverter}, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="4"/>

            <TextBlock Text="Количество на складе:"/>
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="4"/>

            <TextBlock Text="Минимальный остаток:"/>
            <TextBox Text="{Binding MinimumStock, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="4"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Товар" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
            <TextBlock Text="Наименование:" Foreground="Black"/>
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,12"/>

            <TextBlock Text="Цена за единицу:" Foreground="Black"/>
            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2} руб.}" FontSize="14" Margin="0,2,0,12"/>

            <TextBlock Text="Количество на складе:" Foreground="Black"/>
            <TextBlock Text="{Binding Quantity}" FontSize="14" FontWeight="Bold" Margin="0,2,0,12">
                <TextBlock.Foreground>
                    <Binding Path="IsLowStock" Converter="{StaticResource StockColorConverter}"/>
                </TextBlock.Foreground>
            </TextBlock>

            <TextBlock Text="Минимальный остаток:" Foreground="Black"/>
            <TextBlock Text="{Binding MinimumStock}" FontSize="14" Margin="0,2,0,12"/>
            <TextBlock Text="Общая стоимость на складе:" Foreground="Black"/>
            <TextBlock Text="{Binding TotalValue, StringFormat={}{0:N2} руб.}" FontSize="16" FontWeight="Bold" Foreground="DarkGreen" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</Window>
